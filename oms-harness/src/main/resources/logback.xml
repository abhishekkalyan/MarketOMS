<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level [harness] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.cobain.oms.harness" level="DEBUG"/>
    <logger name="io.aeron" level="WARN"/>
    <logger name="org.agrona" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
